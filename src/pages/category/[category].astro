---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import Sidebar from '../../components/Sidebar.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { CATEGORIES, slugifyTag } from '../../lib/categories.ts';
import { getPostsByCategory } from '../../lib/posts.ts';
import { breadcrumbSchema } from '../../lib/seo.ts';

export async function getStaticPaths() {
  return CATEGORIES.map((category) => ({
    params: { category: slugifyTag(category) },
    props: { category },
  }));
}

const { category } = Astro.props;
const posts = await getPostsByCategory(category);
const crumbs = [
  { name: 'Home', url: '/' },
  { name: category, url: `/category/${slugifyTag(category)}/` },
];
---
<Base
  title={category}
  description={`${category}: ${posts.length} articles from The Wealthy Monk — ${category.toLowerCase()} explained simply.`}
  jsonLd={[breadcrumbSchema(crumbs)]}
>
  <Breadcrumbs crumbs={crumbs} />
  <h1 class="section-title" style="margin-top:1rem;">{category}</h1>
  <p style="color:var(--muted);">{posts.length} article{posts.length === 1 ? '' : 's'}</p>
  <div class="with-sidebar">
    <div class="post-grid">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
    <Sidebar />
  </div>
</Base>
