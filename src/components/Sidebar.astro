---
import { CATEGORIES, slugifyTag } from '../lib/categories.ts';
import { getAllPosts, postSlug } from '../lib/posts.ts';

interface Props { categories?: boolean; recentCount?: number; }
const { categories = true, recentCount = 5 } = Astro.props;

const posts = await getAllPosts();
const counts = new Map<string, number>();
for (const p of posts) {
  if (p.data.category) counts.set(p.data.category, (counts.get(p.data.category) ?? 0) + 1);
}
const recent = posts.slice(0, recentCount);
---
<aside class="sidebar">
  {categories && (
  <div class="sidebar-card">
    <h3>Categories</h3>
    <ul class="sidebar-cats">
      {CATEGORIES.map((c) => (
        <li>
          <a href={`/category/${slugifyTag(c)}/`}>{c}</a>
          <span class="count">{counts.get(c) ?? 0}</span>
        </li>
      ))}
    </ul>
  </div>
  )}

  <div class="sidebar-card">
    <h3>Recent posts</h3>
    <ul class="sidebar-recent">
      {recent.map((p) => (
        <li>
          <a class="recent-item" href={`/posts/${postSlug(p)}/`}>
            {p.data.cover && (
              <img class="recent-thumb" src={p.data.cover} alt="" loading="lazy" width="76" height="57" />
            )}
            <span class="recent-text">
              <span class="recent-title">{p.data.title}</span>
              <span class="meta">{p.data.publishDate.toLocaleDateString('en-IN', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <div class="sidebar-card sidebar-course">
    <h3>Free course</h3>
    <p style="margin:0 0 0.8rem;font-size:0.9rem;color:var(--muted);">New to the markets? <strong>InvestED</strong> explains investing from scratch — free, step by step.</p>
    <a class="btn" href="/invested/">Start InvestED →</a>
  </div>
</aside>
