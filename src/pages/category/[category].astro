---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { CATEGORIES, slugifyTag } from '../../lib/categories.ts';
import { getPostsByCategory } from '../../lib/posts.ts';

export async function getStaticPaths() {
  return CATEGORIES.map((category) => ({
    params: { category: slugifyTag(category) },
    props: { category },
  }));
}

const { category } = Astro.props;
const posts = await getPostsByCategory(category);
---
<Base title={category} description={`Articles on ${category} from The Wealthy Monk.`}>
  <h1 class="section-title" style="margin-top:2rem;">{category}</h1>
  <p style="color:var(--muted);">{posts.length} article{posts.length === 1 ? '' : 's'}</p>
  <div class="post-grid">
    {posts.map((post) => <PostCard post={post} />)}
  </div>
</Base>
