---
import { render } from 'astro:content';
import readingTime from 'reading-time';
import Base from '../../layouts/Base.astro';
import CategoryChips from '../../components/CategoryChips.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import SeriesNav from '../../components/SeriesNav.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import LikeButton from '../../components/LikeButton.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import Sidebar from '../../components/Sidebar.astro';
import CommentSection from '../../components/CommentSection.astro';
import AdUnit from '../../components/AdUnit.astro';
import { getAllPosts, postSlug, getAdjacentInSeries } from '../../lib/posts.ts';
import { canonical, abs, articleSchema, breadcrumbSchema } from '../../lib/seo.ts';
import { slugifyTag } from '../../lib/categories.ts';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({ params: { slug: postSlug(post) }, props: { post } }));
}

const { post } = Astro.props;
const slug = postSlug(post);
const { Content, headings } = await render(post);
const { prev, next } = await getAdjacentInSeries(post);

const all = await getAllPosts();
const related = all
  .filter((p) => postSlug(p) !== slug && p.data.category === post.data.category)
  .slice(0, 3);

const rt = readingTime(post.body ?? '');
const date = post.data.publishDate.toLocaleDateString('en-IN', {
  year: 'numeric', month: 'long', day: 'numeric',
});
const toc = headings.filter((h) => (h.depth === 2 || h.depth === 3) && h.text.trim());

const url = canonical(`/posts/${slug}/`);
const published = post.data.publishDate.toISOString();
const modified = (post.data.originalDate ?? post.data.publishDate).toISOString();
const crumbs = [
  { name: 'Home', url: '/' },
  ...(post.data.category ? [{ name: post.data.category, url: `/category/${slugifyTag(post.data.category)}/` }] : []),
  { name: post.data.title, url: `/posts/${slug}/` },
];
const jsonLd = [
  articleSchema({
    title: post.data.title,
    description: post.data.excerpt,
    url,
    image: abs(post.data.cover),
    datePublished: published,
    dateModified: modified,
    section: post.data.category,
  }),
  breadcrumbSchema(crumbs),
];
---
<Base
  title={post.data.title}
  description={post.data.excerpt}
  image={post.data.cover}
  type="article"
  publishedTime={published}
  modifiedTime={modified}
  section={post.data.category}
  jsonLd={jsonLd}
>
  <ReadingProgress />
  <Breadcrumbs crumbs={crumbs} />
  <div class="with-sidebar post-layout">
  <article class="prose">
    <header class="article-header">
      {post.data.series && (
        <a class="chip" href="/invested/">{post.data.series} · Chapter {post.data.seriesOrder}</a>
      )}
      <h1>{post.data.title}</h1>
      <p class="article-meta">{date} · {rt.text}</p>
      <CategoryChips category={post.data.category} tags={post.data.tags} />
    </header>

    {post.data.cover && (
      <img src={post.data.cover} alt={post.data.title} fetchpriority="high" decoding="async" />
    )}

    {toc.length >= 3 && (
      <nav class="toc" aria-label="Table of contents">
        <strong>In this article</strong>
        <ol>
          {toc.map((h) => (
            <li style={h.depth === 3 ? 'margin-left:1rem' : ''}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    <div class="article-body">
      <Content />
    </div>

    <AdUnit />

    <div class="post-actions">
      <LikeButton slug={slug} />
    </div>
    <ShareButtons title={post.data.title} path={`/posts/${slug}/`} />

    <SeriesNav prev={prev} next={next} />
    <Disclaimer />
  </article>
  <Sidebar categories={false} recentCount={3} />
  </div>

  <RelatedPosts posts={related} />

  <div class="prose">
    <CommentSection slug={slug} />
  </div>
</Base>
