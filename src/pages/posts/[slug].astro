---
import { render } from 'astro:content';
import readingTime from 'reading-time';
import Base from '../../layouts/Base.astro';
import CategoryChips from '../../components/CategoryChips.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import SeriesNav from '../../components/SeriesNav.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import LikeButton from '../../components/LikeButton.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import CommentSection from '../../components/CommentSection.astro';
import { getAllPosts, postSlug, getAdjacentInSeries } from '../../lib/posts.ts';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({ params: { slug: postSlug(post) }, props: { post } }));
}

const { post } = Astro.props;
const slug = postSlug(post);
const { Content, headings } = await render(post);
const { prev, next } = await getAdjacentInSeries(post);

const all = await getAllPosts();
const related = all
  .filter((p) => postSlug(p) !== slug && p.data.category === post.data.category)
  .slice(0, 3);

const rt = readingTime(post.body ?? '');
const date = post.data.publishDate.toLocaleDateString('en-IN', {
  year: 'numeric', month: 'long', day: 'numeric',
});
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
<Base title={post.data.title} description={post.data.excerpt} image={post.data.cover}>
  <ReadingProgress />
  <article class="prose">
    <header class="article-header">
      {post.data.series && (
        <a class="chip" href="/invested/">{post.data.series} · Chapter {post.data.seriesOrder}</a>
      )}
      <h1>{post.data.title}</h1>
      <p class="article-meta">{date} · {rt.text}</p>
      <CategoryChips category={post.data.category} tags={post.data.tags} />
    </header>

    {post.data.cover && <img src={post.data.cover} alt={post.data.title} />}

    {toc.length >= 3 && (
      <nav class="toc" aria-label="Table of contents">
        <strong>In this article</strong>
        <ol>
          {toc.map((h) => (
            <li style={h.depth === 3 ? 'margin-left:1rem' : ''}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    <div class="article-body">
      <Content />
    </div>

    <div class="post-actions">
      <LikeButton slug={slug} />
    </div>
    <ShareButtons title={post.data.title} path={`/posts/${slug}/`} />

    <SeriesNav prev={prev} next={next} />
    <Disclaimer />
  </article>

  <RelatedPosts posts={related} />

  <div class="prose">
    <CommentSection slug={slug} />
  </div>
</Base>
