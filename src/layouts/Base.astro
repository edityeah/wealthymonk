---
import '../styles/global.css';
import SiteNav from '../components/SiteNav.astro';
import Newsletter from '../components/Newsletter.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { getCollection } from 'astro:content';
import { SITE, pageTitle, canonical, abs, siteSchema } from '../lib/seo.ts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  section?: string;
  noindex?: boolean;
  jsonLd?: object[];
}
const {
  title, description, image, type = 'website',
  publishedTime, modifiedTime, section, noindex = false, jsonLd = [],
} = Astro.props;

const desc = description ?? SITE.description;
const url = canonical(Astro.url.pathname);
const fullTitle = pageTitle(title);
const ogImage = abs(image) ?? SITE.defaultImage;
const robots = noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
const schemas = [...siteSchema(), ...jsonLd];

const footerPages = (await getCollection('pages'))
  .filter((p) => p.data.showInFooter)
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const cfaToken = import.meta.env.PUBLIC_CFA_TOKEN;
const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Google Consent Mode v2 defaults (must run before ad/analytics tags) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      gtag('consent', 'default', {
        ad_storage: 'denied', ad_user_data: 'denied',
        ad_personalization: 'denied', analytics_storage: 'denied',
      });
      try {
        if (localStorage.getItem('cookie-consent') === 'granted') {
          gtag('consent', 'update', {
            ad_storage: 'granted', ad_user_data: 'granted',
            ad_personalization: 'granted', analytics_storage: 'granted',
          });
        }
      } catch (e) {}
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#1f2937" />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={url} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={url} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:alt" content={title ?? SITE.title} />}
    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {type === 'article' && section && <meta property="article:section" content={section} />}

    <!-- Twitter -->
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:site" content={SITE.twitter} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {schemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}

    {adsenseClient && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
        crossorigin="anonymous"
      ></script>
    )}

    <slot name="head" />
  </head>
  <body>
    <header class="site-header"><SiteNav /></header>
    <main class="container"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <h4>The Wealthy Monk</h4>
          <p style="max-width:28ch;font-size:0.9rem;">{SITE.tagline}</p>
        </div>
        <div>
          <h4>Read</h4>
          <ul>
            <li><a href="/invested/">InvestED course</a></li>
            <li><a href="/archive/">Archive</a></li>
            <li><a href="/search/">Search</a></li>
            <li><a href="/rss.xml">RSS</a></li>
          </ul>
        </div>
        <div>
          <h4>Site</h4>
          <ul>
            {footerPages.map((p) => (
              <li><a href={`/${p.data.slug}/`}>{p.data.title}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h4>Follow</h4>
          <ul>
            <li><a href={SITE.social.facebook} rel="noopener">Facebook</a></li>
            <li><a href={SITE.social.instagram} rel="noopener">Instagram</a></li>
            <li><a href={SITE.social.x} rel="noopener">X / Twitter</a></li>
          </ul>
        </div>
        <div style="flex-basis:260px;"><Newsletter /></div>
      </div>
      <div class="container" style="margin-top:1.5rem;font-size:0.8rem;color:#7f8fa0;">
        © {new Date().getFullYear()} The Wealthy Monk. For education only — not financial advice.
      </div>
    </footer>
    <ConsentBanner />
    {cfaToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${cfaToken}"}`}
      ></script>
    )}
  </body>
</html>
